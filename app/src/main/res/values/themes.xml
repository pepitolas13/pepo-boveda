<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PepoBoveda" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/obsidiana</item>
        <item name="android:navigationBarColor">@color/obsidiana</item>
        <item name="android:windowBackground">@color/obsidiana</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.PepoBoveda.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/transparente</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:statusBarColor">@color/transparente</item>
        <item name="android:navigationBarColor">@color/transparente</item>
    </style>
</resources>
