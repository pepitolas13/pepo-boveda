# Copia este archivo como keystore.properties y rellena TUS valores.
# keystore.properties NO se sube a git, NO se comparte, NO se versiona.
# Si lo pierdes junto con el .jks, no podras volver a actualizar la app:
# Android exige la misma firma para cada actualizacion.
#
# USO:
#   1. Copia este archivo: cp keystore.properties.ejemplo keystore.properties
#   2. Rellena tus valores reales en keystore.properties
#   3. NUNCA hagas git add keystore.properties o *.jks

storeFile=pepo-boveda.jks
storePassword=<USA_UNA_CONTRASEÑA_FUERTE_AQUI>
keyAlias=pepoboveda
keyPassword=<USA_UNA_CONTRASEÑA_FUERTE_AQUI>
