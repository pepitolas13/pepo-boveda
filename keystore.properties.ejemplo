# Copia este archivo como keystore.properties y rellena TUS valores.
# keystore.properties no se sube a ningun sitio ni se comparte. Si lo pierdes junto
# con el .jks, no podras volver a actualizar la app: Android exige la misma firma.

storeFile=pepo-boveda.jks
storePassword=<TU_PASSWORD_DEL_ALMACEN>
keyAlias=pepoboveda
keyPassword=<TU_PASSWORD_DE_LA_CLAVE>
